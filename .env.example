# Backend API endpoint (points to Express server /api base)
# Local: http://localhost:5000/api
# Production: https://q2-connect-api.onrender.com/api (or https://q2-connect-api.onrender.com)
VITE_API_URL=https://q2-connect-api.onrender.com/api
# Alternative Vercel name:
API_URL=https://q2-connect-api.onrender.com

# Public Site URL
# Local: http://localhost:8080
# Production: https://mrvishwakarma.in
VITE_SITE_URL=https://mrvishwakarma.in
# Alternative Vercel name:
SITE_URL=https://mrvishwakarma.in

# WebSocket Server endpoint (points to Socket.io root)
# Local: http://localhost:5000
# Production: https://q2-connect-api.onrender.com
VITE_SOCKET_URL=https://q2-connect-api.onrender.com

# Google OAuth Web Client ID (from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=993848360804-r3oc4v2mnb2ua7m247j1innmbcghiqmg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=993848360804-r3oc4v2mnb2ua7m247j1innmbcghiqmg.apps.googleusercontent.com
