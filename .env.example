# ====================================
# Q2 Connect Suite — Frontend Env Vars
# ====================================

# Backend API endpoint (points to Express server /api base)
# Local: http://localhost:5000/api
# Production: https://api.q2connect.com/api (or https://q2-connect-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# WebSocket Server endpoint (points to Socket.io root)
# Local: http://localhost:5000
# Production: https://api.q2connect.com (or https://q2-connect-backend.onrender.com)
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth Web Client ID (from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
