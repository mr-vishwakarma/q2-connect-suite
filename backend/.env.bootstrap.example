# ==============================================================================
# Hosteliq — Super Administrator One-Time Provisioning Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.bootstrap in the backend directory:
#      cp backend/.env.bootstrap.example backend/.env.bootstrap
# 2. Fill in the values for your target database.
# 3. Execute:
#      npm run seed:super-admin
# 4. Once provisioned, remove or securely store .env.bootstrap.
#    DO NOT commit .env.bootstrap to version control.
# ==============================================================================

# Target MongoDB Connection URI (credentials with special characters must be percent-encoded)
MONGODB_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# Safety Guard 1: Explicit Database Verification
# The bootstrap command strictly verifies that mongoose.connection.name matches this value.
# Refuses to run if missing or mismatched, preventing accidental operations on unintended databases.
EXPECTED_DB_NAME=hosteliq_prodtest

# Safety Guard 2: Explicit Bootstrap Authorization
# Must be set to true to permit creation of the Super Administrator account.
ALLOW_SUPERADMIN_BOOTSTRAP=true

# Initial Super Admin Credentials
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@hosteliq.in
SUPERADMIN_PASSWORD=Super12345Admin!@#$

