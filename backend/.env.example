# ===================================
# Q2 Connect Suite — Backend Env Vars
# ===================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/q2connect?retryWrites=true&w=majority

# Bootstrap Security
ADMIN_REGISTRATION_SECRET=your_super_secret_admin_registration_key

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Canonical production redirect URI registered in Google Cloud Console
GOOGLE_CALLBACK_URL=https://mrvishwakarma.in/auth/google/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Resend Transactional Email (Primary)
# Get API key from Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Q2 Connect Suite <noreply@mrvishwakarma.in>

# Nodemailer / SMTP (Resilient Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Q2 Connect Suite <noreply@mrvishwakarma.in>

# Frontend & CORS Origins (Permits single or comma-separated URLs)
FRONTEND_URL=https://mrvishwakarma.in
CLIENT_URL=https://mrvishwakarma.in
CORS_ORIGIN=https://mrvishwakarma.in
SITE_URL=https://mrvishwakarma.in

# Redis & Distributed BullMQ (Phase D)
# In production (Render/Upstash/ElastiCache): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Razorpay Payment Gateway (Phase F)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=test

# MSG91 WhatsApp Notifications (Phase 6)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_INTEGRATED_NUMBER=your_msg91_integrated_number
MSG91_WHATSAPP_TEMPLATE_ID=your_approved_template_slug_or_id

# Voucher & Coupon Cryptographic Secrets (Phase H - Super Admin Vouchers)
VOUCHER_LOOKUP_SECRET=your_dedicated_voucher_lookup_secret_64hex
VOUCHER_PIN_SECRET=your_dedicated_voucher_pin_secret_64hex
